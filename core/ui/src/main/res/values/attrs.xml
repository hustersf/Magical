<?xml version="1.0" encoding="utf-8"?>
<resources>
  <!-- 声明 RoundImageView 的自定义属性 -->
  <declare-styleable name="RoundImageView">
    <!-- 是否是正圆形 -->
    <attr name="is_circle" format="boolean" />
    <!-- 统一的圆角半径 -->
    <attr name="radius" format="dimension" />
  </declare-styleable>

  <declare-styleable name="SegmentedProgressBar">
    <!-- 片段之间的间隔大小 -->
    <attr name="pb_segmentGap" format="dimension" />
    <!-- 默认未填充时的底色 -->
    <attr name="pb_colorEmpty" format="color|reference" />
  </declare-styleable>
</resources>