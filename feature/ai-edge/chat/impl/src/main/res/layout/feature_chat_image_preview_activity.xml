<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@color/feature_chat_detail_image_prevew_bg">

  <com.google.android.material.button.MaterialButton
    android:id="@+id/close_btn"
    style="@style/CoreUiButton.IconButton"
    app:icon="@drawable/core_ic_cancel"
    app:iconTint="@android:color/white"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintTop_toTopOf="parent" />

  <ImageView
    android:id="@+id/preview_iv"
    android:layout_width="0dp"
    android:layout_height="0dp"
    android:layout_marginBottom="@dimen/core_ui_spacing_xl"
    android:layout_marginTop="@dimen/core_ui_spacing_lg"
    android:adjustViewBounds="true"
    android:scaleType="fitCenter"
    app:layout_constraintBottom_toBottomOf="parent"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintTop_toBottomOf="@+id/close_btn" />

</androidx.constraintlayout.widget.ConstraintLayout>