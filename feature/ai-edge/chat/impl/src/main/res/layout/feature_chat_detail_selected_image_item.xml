<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  android:layout_width="wrap_content"
  android:layout_height="wrap_content">

  <com.sofar.core.ui.image.RoundImageView
    android:id="@+id/preview_iv"
    android:layout_width="@dimen/feature_chat_detail_image_size"
    android:layout_height="@dimen/feature_chat_detail_image_size"
    android:background="?attr/colorSurfaceVariant"
    android:scaleType="centerCrop"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintTop_toTopOf="parent"
    app:radius="@dimen/core_ui_corner_radius_md" />

  <com.sofar.core.ui.image.RoundImageView
    android:id="@+id/image_mask_iv"
    android:layout_width="0dp"
    android:layout_height="0dp"
    android:background="@drawable/core_shape_image_mask_cover"
    android:visibility="gone"
    app:layout_constraintBottom_toBottomOf="@+id/preview_iv"
    app:layout_constraintEnd_toEndOf="@+id/preview_iv"
    app:layout_constraintStart_toStartOf="@+id/preview_iv"
    app:layout_constraintTop_toTopOf="@+id/preview_iv"
    app:radius="@dimen/core_ui_corner_radius_md" />

  <ImageView
    android:id="@+id/delete_iv"
    android:layout_width="@dimen/core_ui_icon_size_medium"
    android:layout_height="@dimen/core_ui_icon_size_medium"
    android:padding="@dimen/core_ui_spacing_xs"
    android:src="@drawable/core_ic_circle_cancel"
    android:visibility="gone"
    app:layout_constraintEnd_toEndOf="@+id/preview_iv"
    app:layout_constraintTop_toTopOf="@+id/preview_iv"
    app:tint="@android:color/white" />

  <ImageView
    android:id="@+id/add_iv"
    android:layout_width="@dimen/core_ui_icon_size_medium"
    android:layout_height="@dimen/core_ui_icon_size_medium"
    android:src="@drawable/core_ic_add"
    android:visibility="gone"
    app:layout_constraintBottom_toBottomOf="@+id/preview_iv"
    app:layout_constraintEnd_toEndOf="@+id/preview_iv"
    app:layout_constraintStart_toStartOf="@+id/preview_iv"
    app:layout_constraintTop_toTopOf="@+id/preview_iv"
    app:tint="?attr/colorPrimary" />
</androidx.constraintlayout.widget.ConstraintLayout>